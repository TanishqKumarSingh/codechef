#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        string A, B;

        cin >> N;
        cin >> A;
        cin >> B;

        int aA = 0, aB = 0;

        for (char c : A) {
            if (c == 'a')
                aA++;
        }

        for (char c : B) {
            if (c == 'a')
                aB++;
        }

       
        if (aA == N - aB)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}