#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int X, Y;
        cin >> X >> Y;

        for (int days = 1; days <= 201; days++) {

            bool possible = false;

            
            for (int k = 1; k <= days; k++) {

              
                long long sum = 1LL * k * (k + 1) * (2 * k + 1) / 6;

                
                long long totalMining =
                    Y * (sum + 1LL * (days - k) * k * k);

                long long totalCost = 1LL * k * X;

                if (totalMining > totalCost) {
                    possible = true;
                    break;
                }
            }

            if (possible) {
                cout << days << endl;
                break;
            }
        }
    }

    return 0;
}