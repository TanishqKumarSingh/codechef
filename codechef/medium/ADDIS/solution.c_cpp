#include <bits/stdc++.h>
using namespace std;

int main() {
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        map<int, int> freq;

        for (int i = 0; i < N; i++) {
            int x;
            cin >> x;
            freq[x]++;
        }

        int maximum = 0;

        for (auto x : freq) {
            if (x.second > maximum) {
                maximum = x.second;
            }
        }

        cout << (maximum + 1) / 2 << endl;
    }

    return 0;
}
}
